#!/usr/bin/python3
"""Desktop controls for the existing independent Reims macOS launcher."""
import fcntl
import runpy
import json
import os
from pathlib import Path
import socket
import stat
import struct
import subprocess
import sys
import time
import struct

ROOT = Path.home() / 'reims-9070xt'
TITLE = 'macOS (Reims / RX 9070 XT)'
QMP_TIMEOUT = 5.0
WAKE_TIMEOUT = 15.0


def notify(message):
    subprocess.run(['notify-send', '-a', TITLE, '-i', 'computer', TITLE, message], check=False)


def state():
    result = subprocess.run(['systemctl', '--user', 'show', 'reims-9070xt.service',
                             '--property=ActiveState', '--value'], capture_output=True, text=True)
    return result.stdout.strip() or 'inactive'


def current_run():
    run = (ROOT / 'current').resolve(strict=True)
    if run.parent != (ROOT / 'runs').resolve() or run.stat().st_uid != os.getuid():
        raise RuntimeError('The current Reims run is not owned by this account.')
    return run


class QMP:
    """A bounded QMP connection to this account's current Reims run."""

    def __init__(self, run):
        path = run / 'qmp.sock'
        info = path.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError('The current run has no owned QMP socket.')
        self.connection = socket.socket(socket.AF_UNIX)
        self.channel = None
        self.sequence = 0
        try:
            self.connection.settimeout(QMP_TIMEOUT)
            self.connection.connect(str(path))
            # A socket path owned by us must also connect to a peer owned by us.
            peer = self.connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
            _, uid, _ = struct.unpack('3i', peer)
            if uid != os.getuid():
                raise RuntimeError('The current run has an unexpected QMP owner.')
            self.channel = self.connection.makefile('rwb', buffering=0)
            greeting = self._read(time.monotonic() + QMP_TIMEOUT)
            if not isinstance(greeting.get('QMP'), dict):
                raise RuntimeError('The current run did not answer as QMP.')
            self.command('qmp_capabilities')
        except BaseException:
            self.close()
            raise

    def close(self):
        if self.channel is not None:
            self.channel.close()
        self.connection.close()

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()

    def _read(self, deadline):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError('QMP acknowledgement timed out.')
        self.connection.settimeout(remaining)
        line = self.channel.readline(1024 * 1024 + 1)
        if not line:
            raise RuntimeError('QMP closed before acknowledging the request.')
        if len(line) > 1024 * 1024 or not line.endswith(b'\n'):
            raise RuntimeError('QMP sent an oversized or incomplete response.')
        reply = json.loads(line)
        if not isinstance(reply, dict):
            raise RuntimeError('QMP sent an invalid response.')
        return reply

    def command(self, command, arguments=None, timeout=None):
        sequence = self.sequence
        self.sequence += 1
        request = {'execute': command, 'id': sequence}
        if arguments is not None:
            request['arguments'] = arguments
        self.connection.sendall((json.dumps(request) + '\n').encode())
        deadline = time.monotonic() + (QMP_TIMEOUT if timeout is None else timeout)
        while True:
            reply = self._read(deadline)
            if 'event' in reply:
                continue
            if reply.get('id') != sequence:
                raise RuntimeError('QMP sent an unexpected response identifier.')
            if 'error' in reply:
                error = reply['error']
                raise RuntimeError('QMP refused ' + command + ': ' + str(error))
            if 'return' not in reply:
                raise RuntimeError('QMP response has no result.')
            return reply['return']

    def status(self):
        result = self.command('query-status')
        if not isinstance(result, dict) or not isinstance(result.get('status'), str):
            raise RuntimeError('QMP returned an invalid guest status.')
        return result['status']

    def wake(self):
        self.command('system_wakeup')
        deadline = time.monotonic() + WAKE_TIMEOUT
        while True:
            status = self.status()
            if status == 'running':
                return
            if status != 'suspended':
                raise RuntimeError('macOS did not resume: QEMU state is ' + status + '.')
            if time.monotonic() >= deadline:
                raise RuntimeError('macOS resume timed out; no shutdown or termination was sent.')
            time.sleep(0.1)


def saved_session():
    module = ROOT / 'saved-machine.py'
    if not module.is_file():
        return None
    try:
        run = current_run()
    except FileNotFoundError:
        return None
    saved = runpy.run_path(str(module))
    manifest = saved['read_saved'](run)
    return (run, saved, manifest) if manifest else None


def restore_loaded_session(run, saved):
    with (run / 'saved-machine.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            notify('macOS is already restoring. Wait for it to finish.')
            return
        _restore_loaded_session(run, saved)


def _restore_loaded_session(run, saved):
    deadline = time.monotonic() + 180
    while True:
        try:
            with QMP(run) as qmp:
                status = qmp.status()
                peer = struct.unpack('3i', qmp.connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                if status in ('paused', 'prelaunch'):
                    saved['mark_restoring'](run, peer[0])
                    qmp.command('cont', timeout=120)
                    status = qmp.status()
                if status == 'running':
                    peer = struct.unpack('3i', qmp.connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                    saved['mark_restored'](run)
                    control = runpy.run_path(str(ROOT / 'sleep-control.py'))
                    control['window'](peer[0], 'show')
                    notify('macOS restored from disk. Your session is retained.')
                    return
        except (FileNotFoundError, ConnectionRefusedError):
            pass
        if time.monotonic() > deadline:
            raise RuntimeError('Restore did not finish; the saved image has been preserved.')
        time.sleep(.2)


def guest_state():
    session = saved_session()
    if session and session[2]['phase'] == 'saved' and session[1]['process_identity'](session[2]['source_pid']) != session[2].get('source_identity'):
        return 'saved to disk'
    service = state()
    if service == 'active':
        with QMP(current_run()) as qmp:
            return qmp.status()
    return service


def ensure_not_migrating(qmp):
    migration = qmp.command('query-migrate').get('status')
    if migration not in (None, 'none', 'failed', 'cancelled', 'completed'):
        raise RuntimeError('macOS is still saving or cancelling a save. Wait for it to finish.')


def powerdown():
    service = state()
    if service not in ('active', 'activating'):
        session = saved_session()
        if session and session[2]['phase'] == 'saved':
            notify('macOS is saved to disk. Restore it before requesting shutdown.')
            return
        notify('macOS is stopped.')
        return
    if service == 'activating':
        notify('macOS is starting. Wait until it has started before requesting shutdown.')
        return
    # Wake a sleeping guest before delivering its ordinary ACPI shutdown.
    # Never terminate QEMU or request Linux host sleep here.
    with QMP(current_run()) as qmp:
        ensure_not_migrating(qmp)
        status = qmp.status()
        if status == 'paused':
            qmp.command('cont')
        elif status == 'suspended':
            qmp.wake()
        elif status != 'running':
            raise RuntimeError('Cannot request a clean macOS shutdown while QEMU is ' + status + '.')
        (current_run() / 'explicit-shutdown.request').write_text(str(time.time()))
        qmp.command('system_powerdown')
    notify('Shutdown requested. macOS will stop when it finishes shutting down.')


def _main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'start'
    if action == 'status':
        settings = json.loads((ROOT / 'desktop-settings.json').read_text())
        message = f"{guest_state()} — saved build: {settings.get('channel', 'stable')}"
        print(message)
        if '--notify' in sys.argv:
            notify(message)
    elif action == 'usb':
        if state() != 'active':
            raise RuntimeError('Start macOS before selecting USB devices.')
        os.execv(str(ROOT / 'reims-usb-picker.sh'), [str(ROOT / 'reims-usb-picker.sh')])
    elif action == 'stop':
        powerdown()
    elif action == 'start':
        service = state()
        if service == 'activating':
            notify('macOS is already starting.')
            return
        session = saved_session()
        restoring = session is not None and session[2]['phase'] in ('saved', 'restoring')
        if service == 'active' and restoring:
            command = json.loads((session[0] / 'command.json').read_text())
            incoming = 'file:' + str(session[0] / session[2]['image'])
            if any(option == '-incoming' and index + 1 < len(command) and command[index + 1] == incoming
                   for index, option in enumerate(command)):
                restore_loaded_session(session[0], session[1])
                return
            # Source cleanup owns the lifetime lease until every auxiliary has stopped.
            deadline = time.monotonic() + 20
            while state() == 'active' and time.monotonic() < deadline:
                time.sleep(.2)
            if state() == 'active':
                notify('The saved session is finishing cleanup. Open again shortly.')
                return
        elif service == 'active':
            run = current_run()
            with (run / 'saved-machine.lock').open('a') as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    notify('macOS is saving to disk. Wait for saving to finish.')
                    return
                with QMP(run) as qmp:
                    ensure_not_migrating(qmp)
                control = runpy.run_path(str(ROOT / 'sleep-control.py'))
                control['transition'](run, 'resume')
            notify('macOS resumed. Your session is retained.')
            return
        if restoring:
            notify('Checking the saved macOS state and restoring from disk…')
        with open('/var/tmp/reims-host-workload.lock', 'a') as lease:
            try:
                fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError('A coordinated build or performance test is running. Try again when it finishes.')
            result = subprocess.run(['/usr/bin/python3', str(ROOT / 'launch.py')], capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(result.stderr.strip()[-600:] or 'The existing Reims launcher failed.')
        if restoring:
            notify('Restoring macOS RAM and devices from disk…')
            restore_loaded_session(session[0], session[1])
        else:
            notify('macOS is starting using the saved Reims build and display settings.')
    else:
        raise RuntimeError('Usage: reims-macos [start|stop|status [--notify]|usb]')


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'start'
    session = saved_session() if action == 'start' else None
    if session and session[2]['phase'] in ('saved', 'restoring'):
        progress = runpy.run_path(str(ROOT / 'machine-progress.py'))['Progress']
        with progress('Restoring macOS from disk') as display:
            display.update('Checking the saved memory image and restoring your session…')
            _main()
    else:
        _main()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        notify(str(error))
        sys.exit(1)
