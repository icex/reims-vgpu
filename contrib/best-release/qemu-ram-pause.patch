+                                              s->saved_gpu_size, &reason);
+    if (status != RVG_OK) {
+        error_setg(errp, "apple-gfx: saved GPU state refused: %s (reason %u)",
+                   rvg_status_message(status), reason);
+        return false;
+    }
+    s->saved_accepted = true;
+    return true;
