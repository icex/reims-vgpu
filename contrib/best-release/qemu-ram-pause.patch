+        return -EINVAL;
+    }
+    s->saved_gpu = g_malloc(s->saved_gpu_size);
+    if (qemu_get_buffer(f, s->saved_gpu, s->saved_gpu_size) != s->saved_gpu_size) {
+        return -EIO;
+    }
+    s->saved_mapper_size = qemu_get_be32(f);
+    if (s->saved_mapper_size > GiB + MiB ||
